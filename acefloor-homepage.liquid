                    {{ block.settings.image | image_url: width: 480 }} 480w,
                    {{ block.settings.image | image_url: width: 720 }} 720w,
                    {{ block.settings.image | image_url: width: 960 }} 960w,
                    {{ block.settings.image | image_url: width: 1200 }} 1200w,
                    {{ block.settings.image | image_url: width: 1400 }} 1400w
                  "
                  sizes="(min-width: 1400px) 320px, (min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw"
