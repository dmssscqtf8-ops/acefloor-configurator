{% assign hero_image = section.settings.hero_image %}
{% assign hero_video = section.settings.hero_video %}

<section class="acefloor-homepage-section" id="acefloor-homepage-{{ section.id }}">
  <div class="acefloor-hero">
    <div class="acefloor-hero__media">
      {% if hero_video != blank %}
        <video
          class="acefloor-hero__video"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          aria-hidden="true"
          {% if hero_image != blank %}poster="{{ hero_image | image_url: width: 2400 }}"{% endif %}
        >
          {% for source in hero_video.sources %}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {% endfor %}
        </video>
      {% elsif hero_image != blank %}
        <img
          src="{{ hero_image | image_url: width: 2400 }}"
          alt="{{ section.settings.hero_title | escape }}"
          loading="eager"
          width="{{ hero_image.width }}"
          height="{{ hero_image.height }}"
        >
      {% endif %}
      <div class="acefloor-hero__overlay"></div>
    </div>

    <div class="page-width acefloor-hero__content">
      <div class="acefloor-hero__left">
        {% if section.settings.hero_small_text != blank %}
          <div class="acefloor-pill">{{ section.settings.hero_small_text }}</div>
        {% endif %}

        {% if section.settings.hero_title != blank %}
          <h1 class="acefloor-hero__title">{{ section.settings.hero_title }}</h1>
        {% endif %}

        {% if section.settings.hero_text != blank %}
          <div class="acefloor-hero__text rte">{{ section.settings.hero_text }}</div>
        {% endif %}

        <div class="acefloor-hero__buttons">
          {% if section.settings.primary_button_label != blank %}
            <a href="{{ section.settings.primary_button_link | default: '#' }}" class="acefloor-btn acefloor-btn--gold">
              {{ section.settings.primary_button_label }}
            </a>
          {% endif %}

          {% if section.settings.secondary_button_label != blank %}
            <a href="{{ section.settings.secondary_button_link | default: '#' }}" class="acefloor-btn acefloor-btn--ghost">
              {{ section.settings.secondary_button_label }}
            </a>
          {% endif %}
        </div>

        <div class="acefloor-badges">
          {% if section.settings.badge_1 != blank %}
            <span class="acefloor-badge">{{ section.settings.badge_1 }}</span>
          {% endif %}
          {% if section.settings.badge_2 != blank %}
            <span class="acefloor-badge">{{ section.settings.badge_2 }}</span>
          {% endif %}
          {% if section.settings.badge_3 != blank %}
            <span class="acefloor-badge">{{ section.settings.badge_3 }}</span>
          {% endif %}
        </div>
      </div>

      <div class="acefloor-hero__right">
        <div class="acefloor-signature-card">
          {% if section.settings.signature_label != blank %}
            <div class="acefloor-card-label">{{ section.settings.signature_label }}</div>
          {% endif %}
          {% if section.settings.signature_title != blank %}
            <h3>{{ section.settings.signature_title }}</h3>
          {% endif %}
          {% if section.settings.signature_text != blank %}
            <p>{{ section.settings.signature_text }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <div class="page-width acefloor-section acefloor-section--intro">
    {% if section.settings.why_title != blank %}
      <h2 class="acefloor-section-title">{{ section.settings.why_title }}</h2>
    {% endif %}
    {% if section.settings.why_text != blank %}
      <div class="acefloor-section-text rte">{{ section.settings.why_text }}</div>
    {% endif %}

    <div class="acefloor-grid acefloor-grid--3">
      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
          <div class="acefloor-card acefloor-card--dark{% if block.settings.image != blank or block.settings.video != blank %} acefloor-card--has-media{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.video != blank %}
              <div class="acefloor-card__media">
                <video
                  class="acefloor-card__video"
                  autoplay
                  loop
                  muted
                  playsinline
                  preload="metadata"
                  aria-hidden="true"
                  {% if block.settings.image != blank %}poster="{{ block.settings.image | image_url: width: 1200 }}"{% endif %}
                >
                  {% for source in block.settings.video.sources %}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {% endfor %}
                </video>
              </div>
            {% elsif block.settings.image != blank %}
              <div class="acefloor-card__media">
                <img
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 360 }} 360w,
                    {{ block.settings.image | image_url: width: 540 }} 540w,
                    {{ block.settings.image | image_url: width: 720 }} 720w,
                    {{ block.settings.image | image_url: width: 960 }} 960w,
                    {{ block.settings.image | image_url: width: 1200 }} 1200w
                  "
                  sizes="(min-width: 1400px) 420px, (min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
                  alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              </div>
            {% endif %}
            <div class="acefloor-card__body">
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="page-width acefloor-section">
    {% if section.settings.credibility_title != blank %}
      <h2 class="acefloor-section-title">{{ section.settings.credibility_title }}</h2>
    {% endif %}
    {% if section.settings.credibility_text != blank %}
      <div class="acefloor-section-text rte">{{ section.settings.credibility_text }}</div>
    {% endif %}

    <div class="acefloor-grid acefloor-grid--4">
      {% for block in section.blocks %}
        {% if block.type == 'credibility' %}
          <div class="acefloor-card acefloor-card--light{% if block.settings.image != blank or block.settings.video != blank or block.settings.slide_1 != blank or block.settings.slide_2 != blank or block.settings.slide_3 != blank or block.settings.slide_4 != blank %} acefloor-card--has-media{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.slide_1 != blank or block.settings.slide_2 != blank or block.settings.slide_3 != blank or block.settings.slide_4 != blank %}
              <div class="acefloor-card__media acefloor-card__slideshow" data-slideshow data-interval="2600">
                {% if block.settings.slide_1 != blank %}
                  <div class="acefloor-card__slide is-active">
                    <img
                      src="{{ block.settings.slide_1 | image_url: width: 1200 }}"
                      alt="{{ block.settings.slide_1.alt | default: block.settings.title | escape }}"
                      loading="lazy"
                      width="{{ block.settings.slide_1.width }}"
                      height="{{ block.settings.slide_1.height }}"
                    >
                  </div>
                {% endif %}
                {% if block.settings.slide_2 != blank %}
                  <div class="acefloor-card__slide">
                    <img
                      src="{{ block.settings.slide_2 | image_url: width: 1200 }}"
                      alt="{{ block.settings.slide_2.alt | default: block.settings.title | escape }}"
                      loading="lazy"
                      width="{{ block.settings.slide_2.width }}"
                      height="{{ block.settings.slide_2.height }}"
                    >
                  </div>
                {% endif %}
                {% if block.settings.slide_3 != blank %}
                  <div class="acefloor-card__slide">
                    <img
                      src="{{ block.settings.slide_3 | image_url: width: 1200 }}"
                      alt="{{ block.settings.slide_3.alt | default: block.settings.title | escape }}"
                      loading="lazy"
                      width="{{ block.settings.slide_3.width }}"
                      height="{{ block.settings.slide_3.height }}"
                    >
                  </div>
                {% endif %}
                {% if block.settings.slide_4 != blank %}
                  <div class="acefloor-card__slide">
                    <img
                      src="{{ block.settings.slide_4 | image_url: width: 1200 }}"
                      alt="{{ block.settings.slide_4.alt | default: block.settings.title | escape }}"
                      loading="lazy"
                      width="{{ block.settings.slide_4.width }}"
                      height="{{ block.settings.slide_4.height }}"
                    >
                  </div>
                {% endif %}
              </div>
            {% elsif block.settings.video != blank %}
              <div class="acefloor-card__media">
                <video
                  class="acefloor-card__video"
                  autoplay
                  loop
                  muted
                  playsinline
                  preload="metadata"
                  aria-hidden="true"
                  {% if block.settings.image != blank %}poster="{{ block.settings.image | image_url: width: 1200 }}"{% endif %}
                >
                  {% for source in block.settings.video.sources %}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {% endfor %}
                </video>
              </div>
            {% elsif block.settings.image != blank %}
              <div class="acefloor-card__media">
                <img
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 360 }} 360w,
                    {{ block.settings.image | image_url: width: 540 }} 540w,
                    {{ block.settings.image | image_url: width: 720 }} 720w,
                    {{ block.settings.image | image_url: width: 960 }} 960w,
                    {{ block.settings.image | image_url: width: 1200 }} 1200w
                  "
                  sizes="(min-width: 1400px) 320px, (min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw"
                  alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              </div>
            {% endif %}
            <div class="acefloor-card__body">
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

