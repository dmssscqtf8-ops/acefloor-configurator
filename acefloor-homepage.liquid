<script>
  (function() {
    var sectionRoot = document.getElementById('acefloor-homepage-{{ section.id }}');
    if (!sectionRoot) return;

    var slideshows = sectionRoot.querySelectorAll('[data-slideshow]');
    slideshows.forEach(function(slideshow) {
      if (slideshow.dataset.ready === 'true') return;

      var slides = slideshow.querySelectorAll('.acefloor-card__slide');
      if (slides.length < 2) return;

      slideshow.dataset.ready = 'true';

      var index = 0;
      window.setInterval(function() {
        slides[index].classList.remove('is-active');
        index = (index + 1) % slides.length;
        slides[index].classList.add('is-active');
      }, Number(slideshow.dataset.interval) || 2600);
    });
  })();
</script>

