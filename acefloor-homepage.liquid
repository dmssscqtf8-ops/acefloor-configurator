<style>
  #acefloor-homepage-{{ section.id }} {
    background: #050505;
    color: #f5f5f5;
  }

  #acefloor-homepage-{{ section.id }} .page-width {
    max-width: 1440px;
    margin: 0 auto;
    padding-left: 28px;
    padding-right: 28px;
  }

  #acefloor-homepage-{{ section.id }} .acefloor-hero {
    position: relative;
    min-height: clamp(540px, 66vh, 760px);
    display: flex;
    align-items: stretch;
    overflow: hidden;
    background: #050505;
    isolation: isolate;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  #acefloor-homepage-{{ section.id }} .acefloor-hero::before {
    content: "";
    position: absolute;
    right: -8%;
    bottom: -22%;
    width: min(44vw, 680px);
    height: min(44vw, 680px);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(214, 169, 64, 0.2) 0%, rgba(214, 169, 64, 0) 68%);
    filter: blur(18px);
    z-index: 1;
    pointer-events: none;
  }

  #acefloor-homepage-{{ section.id }} .acefloor-hero::after {
    content: "";
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 30px;
    z-index: 1;
    pointer-events: none;
  }

  #acefloor-homepage-{{ section.id }} .acefloor-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #acefloor-homepage-{{ section.id }} .acefloor-hero__media img,
  #acefloor-homepage-{{ section.id }} .acefloor-hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    transform: scale(1.01);
    filter: brightness(0.76);
  }

  #acefloor-homepage-{{ section.id }} .acefloor-hero__media img {
    filter: saturate(0.88) contrast(1.04) brightness(0.72);
  }

  #acefloor-homepage-{{ section.id }} .acefloor-hero__media video,
